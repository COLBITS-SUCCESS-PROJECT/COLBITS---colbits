# Settings for the whole stack (root docker-compose.yml).
# Copy to .env and change what you need. NEVER commit .env
# Running an app without Docker? Use frontend/.env.example or backend/.env.example instead.

# ── Database (PostgreSQL) ──
DB_USER=postgres
DB_PASSWORD=adminpassword
DB_NAME=colbits
DB_PORT=5432

# ── pgAdmin (http://localhost:8888) ──
PGADMIN_EMAIL=admin@colbits.com
PGADMIN_PASSWORD=adminpassword

# ── Backend ──
# Hours without data before a device is reported as inactive
FALCON_INACTIVITY_HOURS=9
SMAC_INACTIVITY_HOURS=3

# ── Frontend ──
# Only VITE_ variables reach the browser: never put secrets here.
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development
# true = mocked API in the browser; set to false to use the real backend
VITE_ENABLE_MSW=true
# true = fake signed-in user; set to false to go through the login page
VITE_DEV_MOCK_SESSION=true
