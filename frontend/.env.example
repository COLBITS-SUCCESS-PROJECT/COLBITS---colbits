# Copy this file to .env and fill in the values.
# NEVER commit .env

# Base URL of the COLBITS API Gateway (required)
VITE_API_BASE_URL=http://localhost:8080

# App environment: development | production
VITE_APP_ENV=development

# Mock API in the browser (dev only). Keep true until the backend services exist;
# set to false to call the real API at VITE_API_BASE_URL.
VITE_ENABLE_MSW=true

# Dev only: sign in a fake user so you can work without the backend.
# Set to false to go through the login page (mock users: docs/specs/auth/SCRUM-61.md, section 6).
VITE_DEV_MOCK_SESSION=true
