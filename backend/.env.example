# Copy to .env (never commit .env). Values match backend/docker-compose.yml for local development.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=adminpassword
DB_NAME=colbits

# API
PORT=3000
# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:47173

# Secret that signs the access tokens. Use a long random value; the API does not start without it.
JWT_SECRET=change-me-to-a-long-random-value
# Token lifetime (NF-06: 15 minutes)
JWT_EXPIRES_IN=15m

# Hours without data before a device is reported as inactive
FALCON_INACTIVITY_HOURS=9
SMAC_INACTIVITY_HOURS=3

# Minutes between fuse openings of one fuse set that still group into one fault (US10, RF-ALR-04)
FAULT_GROUPING_WINDOW_MINUTES=5
