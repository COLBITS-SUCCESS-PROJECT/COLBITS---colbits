# Copy this file to .env and fill in the values.
# NEVER commit .env

# Base URL of the COLBITS API Gateway (required)
VITE_API_BASE_URL=http://localhost:8080

# App environment: development | production
VITE_APP_ENV=development

# Enable mock API in the browser (optional, dev only)
VITE_ENABLE_MSW=false

# Dev only: sign in a fake user until the login page exists (SCRUM-61)
VITE_DEV_MOCK_SESSION=true
