# Copy to .env (never commit .env). Values match backend/docker-compose.yml for local development.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=adminpassword
DB_NAME=colbits

# Hours without data before a device is reported as inactive
FALCON_INACTIVITY_HOURS=9
SMAC_INACTIVITY_HOURS=3
